<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" android:id="@+id/main"
    android:layout_width="match_parent" android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/mainLayout"
        android:layout_width="729dp"
        android:layout_height="407dp"
        android:orientation="horizontal"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="1dp"
        tools:ignore="MissingConstraints">

        <Button
            android:id="@+id/buttonGallerie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gallerie" />

        <Button
            android:id="@+id/buttonControle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contrôle" />

        <Button
            android:id="@+id/buttonDonnees"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Données" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>